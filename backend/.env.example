PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=replace-with-a-separate-otp-hash-secret
OTP_TTL_SECONDS=300

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudinary (free plan)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=miniledger/receipts

# --- DATABASE CONFIGURATION ---
# Option A: Supabase Connection Pooler (uncomment lines below, comment Option B)
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.your-project-ref
# DB_PASSWORD=your-supabase-password
# DB_NAME=postgres
# DB_SSL=true

# Option B: Local PostgreSQL Server
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=miniledger
DB_SSL=false

# Optional alternative: full connection string overrides the fields above when set
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger
